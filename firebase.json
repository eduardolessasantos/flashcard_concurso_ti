{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/ads.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/guias/iso-27002-2022",
        "destination": "/guias/iso-27002-2022/index.html"
      },
      {
        "source": "/guias/lgpd-concursos",
        "destination": "/guias/lgpd-concursos/index.html"
      },
      {
        "source": "/guias/itil4-cobit2019",
        "destination": "/guias/itil4-cobit2019/index.html"
      },
      {
        "source": "/guias",
        "destination": "/guias/index.html"
      },
      {
        "source": "/concursos-abertos",
        "destination": "/concursos-abertos/index.html"
      },
      {
        "source": "/guia-carreira-ti",
        "destination": "/guia-carreira-ti/index.html"
      },
      {
        "source": "/sobre",
        "destination": "/sobre/index.html"
      },
      {
        "source": "/privacidade",
        "destination": "/privacidade/index.html"
      },
      {
        "source": "/termos",
        "destination": "/termos/index.html"
      },
      {
        "source": "/contato",
        "destination": "/contato/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
