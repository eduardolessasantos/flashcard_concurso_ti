rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents (isolated per authenticated UID)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User personalized study statistics
    match /study_stats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User personalized card Leitner states
    match /user_card_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User personalized study guides progress & personal notes
    match /user_lesson_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Custom cards authored by users
    match /custom_cards/{cardId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
